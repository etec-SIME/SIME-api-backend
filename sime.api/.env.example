# URL de conexão com o banco local
DB_URL=jdbc:sqlserver://localhost;databaseName=DBS_SIME;encrypt=true;trustServerCertificate=true

# URL de conexão com o banco no Azure
AZURE_URL=jdbc:sqlserver://server-sime.database.windows.net:1433;database=dbs-sime;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;

# Usuário e Senha do Azure
AZURE_USER=usuario_azure@server-sime
AZURE_PASSWORD=sua_senha_segura

# Usuário e senha do banco
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

JWT_SECRET=chave_unica_secreta_JWT